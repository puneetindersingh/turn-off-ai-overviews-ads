{
  "manifest_version": 3,
  "name": "Turn Off AI Overviews & Ads on Google",
  "version": "1.0.0",
  "description": "Turn off Google AI Overviews and ads instantly. Hide, disable or remove AI results and sponsored ads. Fast, private, no tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Turn Off AI Overviews & Ads",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.co.uk/*",
    "*://www.google.ca/*",
    "*://www.google.com.au/*",
    "*://www.google.de/*",
    "*://www.google.fr/*",
    "*://www.google.es/*",
    "*://www.google.it/*",
    "*://www.google.nl/*",
    "*://www.google.co.in/*",
    "*://www.google.com.br/*",
    "*://www.google.co.jp/*",
    "*://www.google.com.mx/*",
    "*://www.google.ru/*",
    "*://www.google.pl/*",
    "*://www.google.com.tr/*",
    "*://www.google.se/*",
    "*://www.google.ch/*",
    "*://www.google.be/*",
    "*://www.google.at/*",
    "*://www.google.ie/*",
    "*://www.google.co.nz/*",
    "*://www.google.com.sg/*",
    "*://www.google.com.hk/*",
    "*://www.google.co.za/*",
    "*://www.google.pt/*",
    "*://www.google.gr/*",
    "*://www.google.dk/*",
    "*://www.google.fi/*",
    "*://www.google.no/*",
    "*://www.google.cz/*",
    "*://www.google.com.ar/*",
    "*://www.google.cl/*",
    "*://www.google.co.id/*",
    "*://www.google.com.ph/*",
    "*://www.google.com.my/*",
    "*://www.google.co.th/*",
    "*://www.google.com.vn/*",
    "*://www.google.co.kr/*",
    "*://www.google.com.eg/*",
    "*://www.google.com.sa/*",
    "*://www.google.ae/*",
    "*://www.google.com.ua/*",
    "*://www.google.ro/*",
    "*://www.google.hu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
